DATABASE_URL="file:../data/incident.db"
# External portal base URL for links inside email alerts (optional, auto-detected from Host header if omitted)
APP_URL="http://localhost:3000"
# Teams / Power Automate Webhook URL
TEAMS_WEBHOOK_URL="https://your-power-automate-or-teams-webhook-url"
PORT=3000
ADMIN_PASSCODE="admin1234"
ENCRYPTION_SECRET="change-this-to-a-32-byte-secret-key"
# Set to "true" to enforce strict TLS certificate validation on SMTP
SMTP_STRICT_TLS="false"
