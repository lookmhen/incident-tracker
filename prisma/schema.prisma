datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  color       String?    @default("#0284c7")
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  incidents   Incident[]
}

model Incident {
  id           String        @id @default(cuid())
  ticketNo     String        @unique
  reporterName String
  department   String?
  contactInfo  String
  title        String
  description  String
  urgency      String        @default("MEDIUM") // LOW, MEDIUM, HIGH
  categoryId   String?
  categoryRel  Category?     @relation(fields: [categoryId], references: [id])
  category     String?       // Quick string tag for legacy/fast filter e.g. "SAP Basis", "Network"
  status       String        @default("OPEN")   // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  assignedTo   String?
  resolution   String?       // Clean-text fix note for AI context & MCP
  attachments  Attachment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  closedAt     DateTime?
}

model Attachment {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  fileUrl    String
  fileType   String
  fileName   String?
  fileSize   Int?
  createdAt  DateTime @default(now())
}

model IntegrationConfig {
  id          String   @id @default(cuid())
  key         String   @unique // "teams", "smtp", "mcp_security"
  value       String   // JSON string (sensitive fields encrypted with AES-256-GCM)
  isEnabled   Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model NotificationLog {
  id           String   @id @default(cuid())
  ticketNo     String?
  channel      String   // "TEAMS", "EMAIL", "CUSTOM_API"
  destination  String   // Target Webhook URL or Email address
  status       String   // "SUCCESS", "FAILED"
  statusCode   Int?     // e.g. 200, 202, 250, 500
  payload      String?  // JSON payload or email summary sent
  response     String?  // Response body from target server
  errorMessage String?  // Error detail if failed
  createdAt    DateTime @default(now())

  @@index([channel])
  @@index([status])
  @@index([ticketNo])
  @@index([createdAt])
}
