{
  "name": "incident-management-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:scripts",
    "build:scripts": "esbuild scripts/import-csv.ts --bundle --platform=node --format=cjs --outfile=scripts/dist/import-csv.js --external:@prisma/client && esbuild scripts/backup-db.ts --bundle --platform=node --format=cjs --outfile=scripts/dist/backup-db.js --external:@prisma/client",
    "start": "next start",
    "lint": "eslint .",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "mcp": "tsx src/mcp/server.ts",
    "import:csv": "node scripts/import-csv.js",
    "backup:db": "node scripts/backup-db.js",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@prisma/client": "^6.4.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^16.4.6",
    "nodemailer": "^10.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.2",
    "prisma": "^6.4.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.73.0"
  }
}
